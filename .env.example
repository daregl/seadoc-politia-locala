# Copiați în .env. scripts/db.sh generează automat un .env la prima pornire.
DATABASE_URL=postgres://seadoc@127.0.0.1:55432/seadoc
PORT=4100
HOST=127.0.0.1
# 64 de caractere hex: cheia AES-256 pentru fișierele stocate.
STORAGE_KEY=
# Secret pentru amprenta semnăturilor interne.
SIGNATURE_SECRET=
STORAGE_DIR=.data/files
# Doar pe HTTPS: cookie-ul de sesiune devine Secure.
COOKIE_SECURE=false
# Numărul de proxy-uri de încredere din fața aplicației. Fără el, toți clienții par să vină de la adresa proxy-ului,
# iar regula MFA pentru accesul din afara rețelei nu se poate aplica.
TRUST_PROXY=0

# Notificări pe email. Fără SMTP_HOST, emailul este dezactivat și nu se pune nimic în coadă.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SeaDoc <seadoc@exemplu.ro>
# true = TLS de la conectare (de obicei portul 465). false = STARTTLS, obligatoriu dacă există SMTP_USER și serverul nu este local.
SMTP_SECURE=false
# Adresa publică a aplicației, pentru linkurile din email. Fără ea, emailurile nu au link.
APP_URL=https://seadoc.exemplu.ro

# Înregistrare din email. Fără IMAP_HOST, preluarea este dezactivată. Autentificare cu utilizator și parolă (fără OAuth2).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# true = TLS de la conectare. false = STARTTLS, obligatoriu dacă serverul nu este local.
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
# Opționale: intervalele lucrătorilor, în milisecunde, și mesajul maxim adus din căsuță, în octeți.
# MAIL_POLL_MS=15000
# IMAP_POLL_MS=60000
# IMAP_MAX_MESSAGE_BYTES=

# LDAP/Active Directory. Fără LDAP_URL, LDAP_BIND_DN, LDAP_BIND_PASSWORD și LDAP_BASE_DN, autentificarea LDAP este dezactivată.
# Folosiți ldaps://; cu ldap:// în afara mașinii locale, parolele circulă necriptat, iar serverul avertizează la pornire.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# Numele atributului (implicit sAMAccountName) sau un filtru cu {username}, de exemplu (&(objectClass=person)(uid={username})).
LDAP_USER_FILTER=sAMAccountName
# Calea către certificatul PEM al autorității care a emis certificatul serverului LDAP.
LDAP_TLS_CA=
# JSON cu DN-ul complet al grupului și rolul; se aplică primul grup din listă care se regăsește în memberOf.
# De exemplu: {"CN=SeaDoc-Admin,OU=Grupuri,DC=ctp,DC=ro":"admin","CN=SeaDoc-Manageri,OU=Grupuri,DC=ctp,DC=ro":"manager"}
LDAP_GROUP_ROLE_MAP=
# Opționale: sincronizarea periodică, în minute (0 = doar la cerere), și pragul peste care dezactivările cer confirmare.
# LDAP_SYNC_INTERVAL_MINUTES=0
# LDAP_SYNC_MAX_DEACTIVATE_PERCENT=30

# Autentificare unică prin OpenID Connect (Keycloak, ADFS, Entra ID). Fără aceste patru variabile, butonul nu apare.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Adresa înregistrată la furnizor: https://<adresa aplicației>/api/auth/oidc/callback
OIDC_REDIRECT_URI=
# Opționale, cu valorile implicite:
# OIDC_LABEL=Autentificare unică (SSO)
# OIDC_USERNAME_CLAIM=preferred_username
# Domeniul eliminat din numele de forma nume@domeniu (UPN în Entra sau ADFS):
# OIDC_USERNAME_DOMAIN=
# true = conturile necunoscute se creează cu rolul „user”. Implicit sunt refuzate.
# OIDC_AUTO_CREATE=false
# Valorile din ID token care dovedesc autentificarea cu mai mulți factori, separate prin virgulă.
# OIDC_MFA_AMR=mfa,otp,hwk,mca,http://schemas.microsoft.com/claims/multipleauthn
# OIDC_MFA_ACR=http://schemas.openid.net/pape/policies/2007/06/multi-factor
# Director cu rădăcinile de încredere (fișiere .pem, .crt, .cer) pentru verificarea semnăturilor din PDF.
# Gol = niciun lanț nu poate fi confirmat; rezultatul spune „lanț de încredere neverificat”.
# Un fișier al cărui nume începe cu „test-” marchează rădăcina ca fiind de test.
TRUST_ROOTS_DIR=
# Originea agentului local de semnare; intră în politica CSP a paginii (connect-src).
SIGN_AGENT_ORIGIN=http://127.0.0.1:47800
# Cât rămâne valabilă o sesiune de semnare pregătită, în secunde.
SIGN_SESSION_TTL_SECONDS=300
# Limite pentru OCR: pagini pe document și pixeli pe pagină.
# OCR_MAX_PAGES=200
# OCR_MAX_PIXELS=40000000
